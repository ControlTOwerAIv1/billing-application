
# OrderBot Environment Configuration

# Gemini API Key
GEMINI_API_KEY= geminiKeyHere

# Default LLM Model (Tested & Active)
LLM_MODEL=gemini/gemini-3.6-flash

# Telegram Bot Token (Optional for Phase 0 Telegram bot)
TELEGRAM_BOT_TOKEN=telegramBotHere

# Database Path
DB_PATH=orderbot.db

# Public Server Base URL (e.g. http://<CONTABO_IP>:8000 or https://yourdomain.com)
SERVER_BASE_URL=http://127.0.0.1:8000
